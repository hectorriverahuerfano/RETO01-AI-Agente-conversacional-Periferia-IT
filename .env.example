# Proveedor del modelo: anthropic | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# Solo si LLM_PROVIDER=anthropic (nunca en el repo, el front ni los logs)
ANTHROPIC_API_KEY=
# Solo si LLM_PROVIDER=ollama (local)
OLLAMA_URL=http://localhost:11434
# Clave que protege /api/chat y /api/sessions (obligatoria; sin ella el servidor rechaza el chat)
ACCESS_KEY=
# Fecha contra la que se evalúan vigencias de soportes (AAAA-MM-DD). Vacía = hoy.
FECHA_EJECUCION=2026-09-25
# Topes de costo
MAX_ITER=25
MAX_TOKENS_SESION=50000
RATE_LIMIT_POR_MIN=10
LLM_TIMEOUT_MS=60000
PORT=3000
